# Copy this file to ".env.local" and fill in your values.
# Next.js only exposes variables that start with NEXT_PUBLIC_ to the browser.

# FastAPI base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: replace with your real GitHub repo link
NEXT_PUBLIC_GITHUB_URL=https://github.com/arsalansaleh24-collab
